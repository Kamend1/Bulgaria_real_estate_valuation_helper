from utils.fetch_data import fetch_xml, extract_locs, parse_obiavi_geo_path

SITEMAP_INDEX_URL = "https://www.imot.bg/sitemap/index.xml"

HEADERS = {
    "User-Agent": "Mozilla/5.0 valuation-research-bot"
