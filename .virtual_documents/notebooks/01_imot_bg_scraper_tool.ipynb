with open(file_path_valid_geo_types, "w", newline="", encoding="utf-8") as f:
    writer = csv.writer(f)

    writer.writerow([
        "deal_type",
        "geo_path",
        "geo_level_count",
        "geo_1",
        "geo_2",
        "geo_3",
        "route_count"
    ])

    for (deal_type, geo_path), route_count in sorted(geo_counter.items()):
        parts = geo_path.split("/")
        padded = parts + ["", "", ""]

        writer.writerow([
            deal_type,
            geo_path,
            len(parts),
            padded[0],
            padded[1],
            padded[2],
            route_count
        ])

