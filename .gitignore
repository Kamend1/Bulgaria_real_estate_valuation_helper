# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Environment / secrets ─────────────────────────────────────────────────────
# .env.example is intentionally tracked — only ignore the real secrets files
.env
.env.local
.env.*.local
*.secret
secrets.*

# ── Data — heavy/raw, never committed ────────────────────────────────────────
data/
notebooks/data/

# ── Generated outputs ─────────────────────────────────────────────────────────
outputs/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
.virtual_documents/
**/.virtual_documents/

# ── IPython ───────────────────────────────────────────────────────────────────
profile_default/
ipython_config.py

# ── Binary data / model artifacts ────────────────────────────────────────────
*.xlsx
*.xls
*.h5
*.hdf5
*.feather
*.pkl
*.pickle
*.joblib
*.onnx

# ── DB backups ────────────────────────────────────────────────────────────────
*.dump
*.sql.gz
*.pgdump

# ── Local databases ───────────────────────────────────────────────────────────
*.duckdb
*.duckdb.wal
*.duckdb.tmp
*.db
*.sqlite
*.sqlite3

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Test / coverage ───────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ── Python packaging / build ──────────────────────────────────────────────────
build/
dist/
*.egg-info/
.eggs/
*.egg
MANIFEST

# ── Type checking / linting caches ───────────────────────────────────────────
.mypy_cache/
.pytype/
.pyre/
.ruff_cache/

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
tempCodeRunnerFile.py

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
