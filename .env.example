DATABASE_URL=postgresql+psycopg2://appraiser:appraiser@localhost:5432/appraisal

TAXONOMY_DIR=data/taxonomy
RAW_HTML_DIR=data/raw_listing_html
SCRAPE_RUNS_DIR=data/scrape_runs
REPORTS_OUTPUT_DIR=outputs/reports
REPORT_TEMPLATE_PATH=templates/reports/appraisal_template.docx

SCRAPE_MAX_WORKERS_ROUTES=8
SCRAPE_MAX_WORKERS_LISTINGS=16
SCRAPE_DELAY_SECONDS=0.8

APP_TITLE=Дигитален асистент на имотния оценител

# ── Authentication ─────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-long-random-string
# Email that auto-receives admin role when registering (leave empty to disable)
ADMIN_EMAIL=

# ── Cloudflare R2 (S3-compatible) — DVC remote + pg_dump/mlflow backups ────────
# Optional: only needed for `dvc pull`/`dvc push` and scripts.backup_to_r2.
# Get these from the Cloudflare dashboard (R2 > Manage API Tokens).
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
