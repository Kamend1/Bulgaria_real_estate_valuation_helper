DATABASE_URL=postgresql+psycopg2://appraiser:appraiser@localhost:5432/appraisal

TAXONOMY_DIR=data/taxonomy
RAW_HTML_DIR=data/raw_listing_html
SCRAPE_RUNS_DIR=data/scrape_runs
REPORTS_OUTPUT_DIR=outputs/reports
REPORT_TEMPLATE_PATH=templates/reports/appraisal_template.docx
AVM_MODELS_DIR=models/avm

SCRAPE_MAX_WORKERS_ROUTES=8
SCRAPE_MAX_WORKERS_LISTINGS=16
SCRAPE_DELAY_SECONDS=0.8

APP_TITLE=Дигитален асистент на имотния оценител

# ── Authentication ─────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-long-random-string
# Email that auto-receives admin role when registering (leave empty to disable)
ADMIN_EMAIL=
# Set to true once the app is served over HTTPS — adds the Secure flag to the
# session cookie. Leave false for local http://localhost dev.
SESSION_HTTPS_ONLY=false

# ── Cloudflare R2 (S3-compatible) ───────────────────────────────────────────────
# Split by credential tier -- see README's "R2 достъп и ключове" section.

# Read-only, scoped ONLY to the models bucket (Object Read, no write/delete).
# Filled in with REAL, live values on purpose -- this key can only ever read
# avm-models/, never dvc-store/'s other contents or the separate backups
# bucket (which holds pg_dump/PII), so it's intentionally safe to publish:
# anyone who clones this repo can run the app and get real AVM predictions
# immediately, no credential request needed. Worst case if abused: someone
# downloads the trained model artifacts -- no data, no write access.
R2_ACCOUNT_ID=00eeba1a3c4c969a02aa14f83b7979ac
R2_ENDPOINT_URL=https://00eeba1a3c4c969a02aa14f83b7979ac.r2.cloudflarestorage.com
R2_MODELS_ACCESS_KEY_ID=3e8c4c706e1fbf86e85da86ee821451a
R2_MODELS_SECRET_ACCESS_KEY=c9eb182dbc811c5bdf6ad992a106189acf9771d362059b7d08158e9137bdaad1
R2_MODELS_BUCKET_NAME=bg-real-estate-helper

# Read-write. LOCAL MACHINE ONLY -- never put real values here, this file is
# public. Used only by `python -m scripts.train_avm_model --push-to-r2` and
# `python -m scripts.backup_to_r2`, run by the project maintainer. Keep the
# real values in your own untracked .env only.
R2_MAINTAINER_ACCESS_KEY_ID=
R2_MAINTAINER_SECRET_ACCESS_KEY=
R2_BACKUPS_BUCKET_NAME=

# ── AI-assisted valuation (Phase 7) ──────────────────────────────────────────
# LOCAL MACHINE ONLY -- these are your own billed API keys, never commit
# real values here (unlike R2_MODELS_* above, these are not scoped
# read-only credentials). Requires the `vector` Postgres extension -- see
# README's "AI-асистирана оценка" section for setup. Only the key matching
# LLM_DEFAULT_PROVIDER is actually required at runtime; the others can stay
# blank until you switch providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_EMBEDDING_PROVIDER=openai
